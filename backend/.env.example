# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neon: use the POOLED connection string for the app and the DIRECT one for migrations.
# Local PostgreSQL example: postgres://postgres:postgres@localhost:5432/slap
DATABASE_URL=
DATABASE_DIRECT_URL=
# auto = TLS for Neon / sslmode=require URLs; set false for a local PostgreSQL
DATABASE_SSL=auto

# Comma separated browser origins allowed to call the API (CORS + CSRF origin check)
FRONTEND_URL=http://localhost:5500
API_PUBLIC_URL=http://localhost:3000

SESSION_COOKIE_NAME=game_session
# How long this browser stays signed in as a player (a device cookie)
SESSION_TTL_DAYS=365
# lax works when the game and API are on the same site (game.example.com + api.example.com).
# none is only for unrelated domains and needs HTTPS (see docs/deployment.md for why not to).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=example.com
# Number of reverse proxies in front of the app (Render = 1) so rate limits see real client IPs
TRUST_PROXY=0
